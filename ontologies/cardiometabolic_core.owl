<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/safecds/cardiometabolic#"
     xml:base="http://www.semanticweb.org/safecds/cardiometabolic"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    
    <owl:Ontology rdf:about="http://www.semanticweb.org/safecds/cardiometabolic"/>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="#hasCondition"/>
    <owl:ObjectProperty rdf:about="#hasPrescribedDrug"/>

    <!-- Base Clinical Classes -->
    <owl:Class rdf:about="#Patient"/>
    <owl:Class rdf:about="#Condition"/>
    <owl:Class rdf:about="#Medication"/>

    <!-- Granular KDIGO CKD Stages -->
    <owl:Class rdf:about="#CKD_Stage_3a">
        <rdfs:subClassOf rdf:resource="#Condition"/>
    </owl:Class>
    <owl:Class rdf:about="#CKD_Stage_3b">
        <rdfs:subClassOf rdf:resource="#Condition"/>
    </owl:Class>
    <owl:Class rdf:about="#CKD_Stage_4">
        <rdfs:subClassOf rdf:resource="#Condition"/>
    </owl:Class>
    <owl:Class rdf:about="#CKD_Stage_5">
        <rdfs:subClassOf rdf:resource="#Condition"/>
    </owl:Class>
    <owl:Class rdf:about="#CKD_Stage_4_5">
        <rdfs:subClassOf rdf:resource="#Condition"/>
    </owl:Class>

    <!-- Cardiometabolic Comorbidities & Electrolyte Disorders -->
    <owl:Class rdf:about="#Type_2_Diabetes">
        <rdfs:subClassOf rdf:resource="#Condition"/>
    </owl:Class>
    <owl:Class rdf:about="#Hypertension">
        <rdfs:subClassOf rdf:resource="#Condition"/>
    </owl:Class>
    <owl:Class rdf:about="#Heart_Failure">
        <rdfs:subClassOf rdf:resource="#Condition"/>
    </owl:Class>
    <owl:Class rdf:about="#Cardiorenal_Syndrome">
        <rdfs:subClassOf rdf:resource="#Condition"/>
    </owl:Class>
    <owl:Class rdf:about="#Hyperkalemia">
        <rdfs:subClassOf rdf:resource="#Condition"/>
    </owl:Class>
    <owl:Class rdf:about="#PediatricNephropathy">
        <rdfs:subClassOf rdf:resource="#Condition"/>
    </owl:Class>
    <owl:Class rdf:about="#Type_1_Diabetes">
        <rdfs:subClassOf rdf:resource="#Condition"/>
    </owl:Class>

    <!-- Medication Classes -->
    <owl:Class rdf:about="#Metformin">
        <rdfs:subClassOf rdf:resource="#Medication"/>
    </owl:Class>
    <owl:Class rdf:about="#Lisinopril">
        <rdfs:subClassOf rdf:resource="#Medication"/>
    </owl:Class>
    <owl:Class rdf:about="#Insulin">
        <rdfs:subClassOf rdf:resource="#Medication"/>
    </owl:Class>
    <owl:Class rdf:about="#Amlodipine">
        <rdfs:subClassOf rdf:resource="#Medication"/>
    </owl:Class>
    <owl:Class rdf:about="#Losartan">
        <rdfs:subClassOf rdf:resource="#Medication"/>
    </owl:Class>
    <owl:Class rdf:about="#SGLT2_Inhibitor">
        <rdfs:subClassOf rdf:resource="#Medication"/>
    </owl:Class>
    <owl:Class rdf:about="#GLP1_RA">
        <rdfs:subClassOf rdf:resource="#Medication"/>
    </owl:Class>
    <owl:Class rdf:about="#Sulfonylurea">
        <rdfs:subClassOf rdf:resource="#Medication"/>
    </owl:Class>
    <owl:Class rdf:about="#Loop_Diuretic">
        <rdfs:subClassOf rdf:resource="#Medication"/>
    </owl:Class>

    <!-- ======================================================== -->
    <!-- SAFETY AXIOMS (EQUIVALENT CLASS INTERSECTIONS)            -->
    <!-- ======================================================== -->

    <!-- Axiom 1: Metformin contraindicated in advanced CKD Stage 4 (eGFR < 30) -->
    <owl:Class rdf:about="#UnsafeMetforminStage4">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Patient"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasCondition"/>
                        <owl:someValuesFrom rdf:resource="#CKD_Stage_4"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasPrescribedDrug"/>
                        <owl:someValuesFrom rdf:resource="#Metformin"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Metformin is strictly contraindicated in CKD Stage 4 (eGFR &lt; 30 mL/min/1.73m²) due to high risk of fatal lactic acidosis.</rdfs:comment>
    </owl:Class>

    <!-- Axiom 2: Metformin contraindicated in CKD Stage 5 -->
    <owl:Class rdf:about="#UnsafeMetforminStage5">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Patient"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasCondition"/>
                        <owl:someValuesFrom rdf:resource="#CKD_Stage_5"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasPrescribedDrug"/>
                        <owl:someValuesFrom rdf:resource="#Metformin"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Metformin is strictly contraindicated in kidney failure / CKD Stage 5 (eGFR &lt; 15 mL/min/1.73m²).</rdfs:comment>
    </owl:Class>

    <!-- Axiom 3: Backwards compatible generic CKD_Stage_4_5 Metformin -->
    <owl:Class rdf:about="#UnsafeMetforminPrescription">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Patient"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasCondition"/>
                        <owl:someValuesFrom rdf:resource="#CKD_Stage_4_5"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasPrescribedDrug"/>
                        <owl:someValuesFrom rdf:resource="#Metformin"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Metformin is contraindicated in advanced CKD Stage 4/5 due to fatal lactic acidosis risk.</rdfs:comment>
    </owl:Class>

    <!-- Axiom 4: ACE-inhibitor (Lisinopril) contraindicated in Hyperkalemia -->
    <owl:Class rdf:about="#UnsafeACEiHyperkalemia">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Patient"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasCondition"/>
                        <owl:someValuesFrom rdf:resource="#Hyperkalemia"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasPrescribedDrug"/>
                        <owl:someValuesFrom rdf:resource="#Lisinopril"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>High-dose ACE-inhibitors (Lisinopril) are contraindicated in active hyperkalemia (K+ &gt; 5.0 mmol/L) due to fatal cardiac arrhythmia risk.</rdfs:comment>
    </owl:Class>

    <!-- Axiom 5: ACE-inhibitor (Lisinopril) in advanced CKD Stage 4/5 -->
    <owl:Class rdf:about="#UnsafeACEiPrescription">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Patient"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasCondition"/>
                        <owl:someValuesFrom rdf:resource="#CKD_Stage_4_5"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasPrescribedDrug"/>
                        <owl:someValuesFrom rdf:resource="#Lisinopril"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Lisinopril carries severe hyperkalemia and acute renal decline risks in advanced CKD Stage 4/5.</rdfs:comment>
    </owl:Class>

    <!-- Axiom 6: Unsafe oral hypoglycemic in pediatric nephropathy -->
    <owl:Class rdf:about="#UnsafePediatricOralHypoglycemicPrescription">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Patient"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasCondition"/>
                        <owl:someValuesFrom rdf:resource="#PediatricNephropathy"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasPrescribedDrug"/>
                        <owl:someValuesFrom rdf:resource="#Metformin"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Adult oral hypoglycemics are strictly contraindicated in pediatric diabetic nephropathy; basal-bolus insulin is mandated.</rdfs:comment>
    </owl:Class>

</rdf:RDF>
